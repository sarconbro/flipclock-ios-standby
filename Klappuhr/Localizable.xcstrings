{
  "sourceLanguage": "en",
  "strings": {
    "A flip clock for StandBy: one widget for the hours, one for the minutes and seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Klappuhr für StandBy: ein Widget für die Stunden, eines für Minuten und Sekunden."
          }
        }
      }
    },
    "In the dark, iOS automatically tints the clock red.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Dunkeln färbt iOS die Uhr automatisch rot ein."
          }
        }
      }
    },
    "Lock your iPhone, lay it on its side and connect it to a charger.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone sperren, quer hinlegen und ans Ladegerät anschließen."
          }
        }
      }
    },
    "Night mode": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachtmodus"
          }
        }
      }
    },
    "Note: with a free Apple account, the app only runs for 7 days and then has to be reinstalled from Xcode.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis: Mit einem kostenlosen Apple-Account läuft die App nur 7 Tage und muss danach neu aus Xcode installiert werden."
          }
        }
      }
    },
    "Remove the other widgets from both stacks so nothing rotates away.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die anderen Widgets in beiden Stapeln entfernen, damit nichts weiterblättert."
          }
        }
      }
    },
    "Setting up StandBy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So richtest du StandBy ein"
          }
        }
      }
    },
    "Settings → StandBy → turn on Night Mode.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen → StandBy → Nachtmodus einschalten."
          }
        }
      }
    },
    "Settings → StandBy → turn on StandBy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen → StandBy → StandBy einschalten."
          }
        }
      }
    },
    "Swipe left until you see the view with two widget stacks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach links wischen, bis die Ansicht mit zwei Widget-Stapeln kommt."
          }
        }
      }
    },
    "Touch and hold the left stack → “+” → Klappuhr → add “Hours”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linken Stapel gedrückt halten → „+“ → Klappuhr → „Stunden“ hinzufügen."
          }
        }
      }
    },
    "Touch and hold the right stack → “+” → Klappuhr → add “Minutes”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechten Stapel gedrückt halten → „+“ → Klappuhr → „Minuten“ hinzufügen."
          }
        }
      }
    }
  },
  "version": "1.0"
}